# ═══════════════════════════════════════════════════════════
# CogniGap — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ─── Neo4j (required — installed locally) ──────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ─── LLM APIs (Provide one, two, or all!) ────────────────
# CogniGap features an automatic failover waterfall:
# It will try Gemini -> Groq -> OpenAI.
# Whichever works, works! If one hits rate limits or quotas,
# it automatically rolls over to the next without failing.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ─── Qdrant Vector DB ─────────────────────────────────────
# Local mode (default): runs in-memory, no server needed
QDRANT_MODE=local
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ─── GitHub (optional — higher rate limits) ────────────────
GITHUB_TOKEN=

# ─── ArXiv / Patents ──────────────────────────────────────
# ArXiv API is free, no key needed.
# Patent search uses PQAI first and falls back to Google Patents.

# ─── Academic Search ───────────────────────────────────────
# Optional: Semantic Scholar API key improves rate limits.
SEMANTIC_SCHOLAR_API_KEY=

# ─── FastAPI Settings ─────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
