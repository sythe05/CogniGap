# ═══════════════════════════════════════════════════════════
# CogniGap — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.

# ─── Neo4j (required — installed locally) ──────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ─── LLM API (pick one — Gemini recommended) ──────────────
GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# GROQ_API_KEY=your_groq_api_key

# ─── Qdrant Vector DB ─────────────────────────────────────
# Local mode (default): runs in-memory, no server needed
QDRANT_MODE=local
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ─── GitHub (optional — higher rate limits) ────────────────
GITHUB_TOKEN=

# ─── ArXiv / Patents ──────────────────────────────────────
# ArXiv API is free, no key needed.
# PQAI (patent search) is free, no key needed.

# ─── FastAPI Settings ─────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
